@model IEnumerable<TicketSystem.Domain.Models.ApplicationUser>

@{
    ViewData["Title"] = "Teammitglieder";
}

<h2>👥 Teammitglieder</h2>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Rolle</th>
                    <th>Status</th>
                    <th>Erstellt am</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var isAdmin = ViewBag.AdminEmails != null && ((List<string>)ViewBag.AdminEmails).Contains(user.Email);
                    var isTeamleiter = ViewBag.TeamleiterIds != null && ((List<string>)ViewBag.TeamleiterIds).Contains(user.Id);

                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>
                            @if (isAdmin)
                            {
                                <span class="badge bg-warning text-dark">Admin</span>
                            }
                            else if (isTeamleiter)
                            {
                                <span class="badge bg-info">Teamleiter</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">User</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLocked)
                            {
                                <span class="badge bg-danger">Gesperrt</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aktiv</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Zurück</a>
</div>