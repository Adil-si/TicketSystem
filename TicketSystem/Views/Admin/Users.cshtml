@model IEnumerable<TicketSystem.Domain.Models.ApplicationUser>

@{
    ViewData["Title"] = "Benutzer verwalten";
}

<h2 class="mb-3">👥 Benutzer verwalten</h2>

<!-- Buttons kompakter -->
<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-action="GenerateRandomUsers" asp-route-count="5" class="btn btn-sm btn-primary">
        <i class="bi bi-shuffle"></i> +5
    </a>
    <a asp-action="GenerateRandomUsers" asp-route-count="10" class="btn btn-sm btn-secondary">
        <i class="bi bi-shuffle"></i> +10
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr>
                        <th style="width: 30%">Name</th>
                        <th style="width: 25%">Email</th>
                        <th style="width: 10%">Rolle</th>
                        <th style="width: 8%">Status</th>
                        <th style="width: 10%">Erstellt</th>
                        <th style="width: 17%">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isAdmin = ViewBag.AdminEmails != null && ((List<string>)ViewBag.AdminEmails).Contains(user.Email);
                        var isTeamleiter = ViewBag.TeamleiterIds != null && ((List<string>)ViewBag.TeamleiterIds).Contains(user.Id);

                        <tr style="font-size: 0.8rem;">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@Url.Action("UserAvatar", "Admin", new { email = user.Email })"
                                         style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;" />
                                    <span>@user.Name</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-warning text-dark" style="font-size: 0.7rem;">Admin</span>
                                }
                                else if (isTeamleiter)
                                {
                                    <span class="badge bg-info" style="font-size: 0.7rem;">Teamleiter</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" style="font-size: 0.7rem;">User</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLocked)
                                {
                                    <span class="badge bg-danger" style="font-size: 0.7rem;">Gesperrt</span>
                                }
                                else
                                {
                                    <span class="badge bg-success" style="font-size: 0.7rem;">Aktiv</span>
                                }
                            </td>
                            <td style="font-size: 0.75rem;">@user.CreatedAt.ToString("dd.MM.yy")</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (!isAdmin)
                                    {
                                        @if (user.IsLocked)
                                        {
                                            <form asp-action="UnlockUser" method="post" style="display:inline">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-success py-0 px-2" style="font-size: 0.7rem;" onclick="return confirm('@user.Name wirklich entsperren?')">
                                                    <i class="bi bi-unlock"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-warning py-0 px-2" style="font-size: 0.7rem;" onclick="lockUser('@user.Id', '@user.Name')">
                                                <i class="bi bi-lock"></i>
                                            </button>
                                            
                                            <a asp-action="MakeAdmin" asp-route-id="@user.Id" class="btn btn-sm btn-info py-0 px-2" style="font-size: 0.7rem;" onclick="return confirm('@user.Name zum Admin machen?')">
                                                <i class="bi bi-shield"></i>
                                            </a>

                                            @if (User.IsInRole("Admin"))
                                            {
                                                if (isTeamleiter)
                                                {
                                                    <form asp-action="RemoveTeamleiter" asp-route-id="@user.Id" method="post" style="display:inline">
                                                        <button type="submit" class="btn btn-sm btn-secondary py-0 px-2" style="font-size: 0.7rem;" onclick="return confirm('@user.Name als Teamleiter entfernen?')">
                                                            <i class="bi bi-person-dash"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-action="MakeTeamleiter" asp-route-id="@user.Id" method="post" style="display:inline">
                                                        <button type="submit" class="btn btn-sm btn-info py-0 px-2" style="font-size: 0.7rem;" onclick="return confirm('@user.Name zum Teamleiter machen?')">
                                                            <i class="bi bi-person-badge"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function lockUser(userId, userName) {
        var reason = prompt('Grund für Sperrung von ' + userName + ':');
        if (reason && reason.trim() !== '') {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Admin/LockUser';
            
            var idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = userId;
            
            var reasonInput = document.createElement('input');
            reasonInput.type = 'hidden';
            reasonInput.name = 'reason';
            reasonInput.value = reason;
            
            form.appendChild(idInput);
            form.appendChild(reasonInput);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-sm btn-secondary">Zurück</a>
</div>