@{
    ViewData["Title"] = "Registrieren";
}

<div class="container">
    <div class="main-card text-center">
        <h1>✨ Willkommen</h1>
        <h2 class="mb-4">TicketSystem Registrierung</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" class="row justify-content-center">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">👤 Vollständiger Name</label>
                    <input name="name" class="form-control" placeholder="Max Mustermann" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">📧 Email Adresse</label>
                    <input name="email" class="form-control" type="email" placeholder="test@test.de" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">🔒 Passwort</label>
                    <input name="password" class="form-control" type="password" placeholder="test123" required />
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">🚀 Jetzt Registrieren</button>
            </div>
        </form>

        <div class="mt-4">
            <p>Hast du schon ein Konto? <a asp-controller="Account" asp-action="Login" class="nav-link">🔑 Hier einloggen</a></p>
        </div>
    </div>
</div>
