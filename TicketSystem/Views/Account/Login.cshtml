@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <div class="main-card text-center">
        <h1>🔑 Einloggen</h1>
        <h2 class="mb-4">TicketSystem</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" class="row justify-content-center">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">📧 Email</label>
                    <input name="email" class="form-control" type="email" placeholder="test@test.de" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">🔒 Passwort</label>
                    <input name="password" class="form-control" type="password" placeholder="test123" required />
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">✨ Einloggen</button>
            </div>
        </form>

        <div class="mt-4">
            <p>Noch kein Konto? <a asp-controller="Account" asp-action="Register" class="nav-link">📝 Jetzt registrieren</a></p>
        </div>
    </div>
</div>
