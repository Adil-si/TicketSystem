@model TicketSystem.Domain.Models.Ticket
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Neues Ticket erstellen";
}

<h2>Neues Ticket erstellen</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="Title" class="form-label">Titel *</label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Beschreibung *</label>
        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategorie *</label>
        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
            <option value="">-- Bitte wählen --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label">Abteilung</label>
        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
            <option value="">-- Eigene Abteilung --</option>
        </select>
        <small class="form-text text-muted">
            Wenn Sie keine Abteilung wählen, wird Ihre eigene Abteilung verwendet.
        </small>
    </div>
    <div class="mb-3">
        <label class="form-label">Dateianhang (optional)</label>
        <input type="file" name="file" class="form-control" />
        <small class="form-text text-muted">
            Erlaubte Formate: JPG, PNG, PDF, DOC, DOCX, TXT, ZIP. Max. 10 MB.
        </small>
    </div>

    <button type="submit" class="btn btn-primary">Erstellen</button>
    <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}