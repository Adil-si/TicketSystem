@model IEnumerable<TicketSystem.Domain.Models.Ticket>

@{
    ViewData["Title"] = "Tickets";
}

<h2>Tickets</h2>

@if (User.Identity.IsAuthenticated)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Neues Ticket erstellen</a>
    </p>
}

<div class="mb-3">
    <label class="form-label">Abteilung filtern</label>
    <select id="departmentFilter" class="form-control">
        <option value="">-- Alle Abteilungen --</option>
        @foreach (var dept in ViewBag.Departments)
        {
            <option value="@dept.Id">@dept.Name</option>
        }
    </select>
</div>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titel</th>
            <th>Abteilung</th>
            <th>Kategorie</th>
            <th>Status</th>
            <th>Ersteller</th>
            <th>Erstellt am</th>
            <th>Aktionen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@(ticket.Department?.Name ?? "-")</td>
                <td>@(ticket.Category?.Name ?? "Keine Kategorie")</td>
                <td>
                    @if (ticket.Status == TicketStatus.Open)
                    {
                        <span class="badge bg-success">Offen</span>
                    }
                    else if (ticket.Status == TicketStatus.InProgress)
                    {
                        <span class="badge bg-warning">In Bearbeitung</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Geschlossen</span>
                    }
                </td>
                <td>
                    @{
                        var creatorName = ViewBag.CreatorNames != null && ViewBag.CreatorNames.ContainsKey(ticket.ApplicationUserId ?? "")
                            ? ViewBag.CreatorNames[ticket.ApplicationUserId ?? ""]
                            : "Unbekannt";
                    }
                    @creatorName
                </td>
                <td>@ticket.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info">Details</a>
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-warning">Bearbeiten</a>
                    }
                    
                    @if (User.Identity.IsAuthenticated && ticket.Status != TicketStatus.Closed)
                    {
                        <a asp-action="Close" asp-route-id="@ticket.Id" class="btn btn-sm btn-danger">Schließen</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    document.getElementById('departmentFilter').addEventListener('change', function() {
        var deptId = this.value;
        if (deptId) {
            window.location.href = '/Ticket/Index?departmentFilter=' + deptId;
        } else {
            window.location.href = '/Ticket/Index';
        }
    });
</script>
