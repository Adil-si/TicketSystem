@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using System.Security.Cryptography
@using TicketSystem.Application.Services
@inject IMessageService MessageService
@inject SignInManager<ApplicationUser> SignInManager

@{
    // Unread Count einmalig berechnen
    var unreadCount = 0;
    if (User.Identity.IsAuthenticated)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        if (!string.IsNullOrEmpty(userId))
        {
            unreadCount = MessageService.GetUnreadCountAsync(userId).GetAwaiter().GetResult();
        }
    }
}
<!DOCTYPE html>
<html lang="de" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/StyleSheet.css" />
    <style>
        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 260px;
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            color: var(--text);
            z-index: 1000;
            transition: all 0.3s;
            border-right: 1px solid var(--border);
            box-shadow: 2px 0 10px rgba(0,0,0,0.05);
        }

        .sidebar-header {
            padding: 24px 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 16px;
        }

        .sidebar-header h3 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 600;
            background: linear-gradient(135deg, #00BD7D, #33cc99);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu li {
            margin-bottom: 2px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 20px;
            color: var(--text);
            text-decoration: none;
            transition: all 0.2s;
            font-size: 0.875rem;
            font-weight: 500;
            border-left: 3px solid transparent;
        }

        .sidebar-menu a:hover {
            background: rgba(0, 189, 125, 0.08);
            border-left-color: #00BD7D;
            color: #00BD7D;
        }

        .sidebar-menu a.active {
            background: rgba(0, 189, 125, 0.12);
            border-left-color: #00BD7D;
            color: #00BD7D;
        }

        .sidebar-menu i {
            width: 22px;
            font-size: 1.1rem;
        }

        .sidebar-menu .dropdown-divider {
            background: var(--border);
            margin: 12px 20px;
            height: 1px;
        }

        .sidebar-footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 20px;
            border-top: 1px solid var(--border);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            padding: 8px 0;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            overflow: hidden;
            background: linear-gradient(135deg, #00BD7D, #009966);
        }

        .user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-name {
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text);
        }

        .user-email {
            font-size: 0.7rem;
            opacity: 0.7;
            color: var(--text);
        }

        .main-content {
            margin-left: 260px;
            padding: 20px;
            min-height: 100vh;
        }

        .logout-btn {
            width: 100%;
            background: rgba(0, 189, 125, 0.1);
            border: none;
            padding: 10px;
            border-radius: 8px;
            color: var(--text);
            text-align: center;
            transition: all 0.2s;
            font-size: 0.875rem;
            cursor: pointer;
        }

        .logout-btn:hover {
            background: rgba(220, 38, 38, 0.7);
            color: white;
        }

        /* Dark Mode */
        [data-bs-theme="dark"] .sidebar {
            background: var(--card-bg);
            border-right-color: var(--border);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                width: 70px;
            }
            .sidebar-header h3,
            .sidebar-menu span,
            .user-info span,
            .logout-btn span {
                display: none;
            }
            .sidebar-menu a {
                justify-content: center;
                padding: 12px;
            }
            .sidebar-menu i {
                margin: 0;
            }
            .user-info {
                justify-content: center;
            }
            .main-content {
                margin-left: 70px;
            }
            .logout-btn {
                padding: 10px;
            }
            .logout-btn i {
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h3>🎫 TicketSystem</h3>
        </div>

        <ul class="sidebar-menu">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a asp-controller="Ticket" asp-action="Index">
                    <i class="bi bi-ticket"></i> <span>Tickets</span>
                </a>
            </li>
            @if (User.Identity.IsAuthenticated)
            {
                <li>
                    <a asp-controller="Ticket" asp-action="Create">
                        <i class="bi bi-plus-circle"></i> <span>Ticket erstellen</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Message" asp-action="Index">
                        <i class="bi bi-envelope"></i> <span>Nachrichten</span>
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-2">@unreadCount</span>
                        }
                    </a>
                </li>
            }
            @if (User.IsInRole("Admin"))
            {
                <li><hr class="dropdown-divider" style="background: rgba(255,255,255,0.1); margin: 10px 20px;"></li>
                <li>
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-shield-lock-fill"></i> <span>Admin Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people"></i> <span>Benutzer verwalten</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Departments">
                        <i class="bi bi-building"></i> <span>Abteilungen</span>
                    </a>
                </li>
            }
            else if (User.IsInRole("Teamleiter"))
            {
                <li><hr class="dropdown-divider" style="background: rgba(255,255,255,0.1); margin: 10px 20px;"></li>
                <li>
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> <span>Team Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Categories">
                        <i class="bi bi-tags"></i> <span>Kategorien</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="TeamUsers">
                        <i class="bi bi-people"></i> <span>Teammitglieder</span>
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            @if (User.Identity.IsAuthenticated)
            {
                var userName = User.FindFirstValue(ClaimTypes.Name) ?? User.Identity.Name;
                var userEmail = User.Identity.Name;
                // Avatar URL mit DiceBear
                var avatarStyle = "adventurer";
                if (User.IsInRole("Admin"))
                {
                    avatarStyle = "micah";
                }
                else if (User.IsInRole("Teamleiter"))
                {
                    avatarStyle = "personas";
                }
                <div class="user-info">
                    <div class="user-avatar">
                        <img src="https://api.dicebear.com/7.x/@avatarStyle/svg?seed=@userEmail"
                             alt="Avatar" />
                    </div>
                    <div>
                        <div class="user-name">@userName</div>
                        <div class="user-email">@userEmail</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="logout-btn">
                        <i class="bi bi-box-arrow-right"></i> <span>Logout</span>
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="logout-btn" style="display: block; text-align: center; text-decoration: none;">
                    <i class="bi bi-box-arrow-in-right"></i> <span>Login</span>
                </a>
                <a asp-controller="Account" asp-action="Register" class="logout-btn" style="display: block; text-align: center; text-decoration: none; margin-top: 10px;">
                    <i class="bi bi-person-plus"></i> <span>Register</span>
                </a>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Dark Mode Toggle oben rechts -->
        <div style="position: fixed; top: 20px; right: 20px; z-index: 1001;">
            <button id="themeToggle" class="theme-toggle" title="Dark/Light Mode">
                <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
            </button>
        </div>

        <!-- Main Content Card -->
        <div class="main-card">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setTheme(theme) {
            document.documentElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem('theme', theme);
            const icon = document.getElementById('themeIcon');
            if (theme === 'dark') {
                icon.classList.remove('bi-moon-stars-fill');
                icon.classList.add('bi-sun-fill');
            } else {
                icon.classList.remove('bi-sun-fill');
                icon.classList.add('bi-moon-stars-fill');
            }
        }

        const savedTheme = localStorage.getItem('theme') || 'light';
        setTheme(savedTheme);

        document.getElementById('themeToggle').addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            setTheme(newTheme);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>